# Optional local server configuration
PORT=3001
HOST=0.0.0.0
OFFSCRIPT_DATA_FILE=data/offscript.json

# Optional Twitch installed-chatbot configuration. Leave credentials blank for demo mode.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Set this to the current Quick Tunnel URL plus /auth/twitch/callback before Twitch auth.
TWITCH_REDIRECT_URI=
DASHBOARD_URL=http://localhost:5173/

# Twitch access and refresh tokens stay in server memory, never in frontend code.
# Never put Twitch tokens in VITE_* variables.
